# ============================================================================
# StitchFlow V2 - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# ============================================================================
# Application Settings
# ============================================================================
APP_NAME=StitchFlow V2
APP_ENV=development  # development, staging, production
DEBUG=True  # Set to False in production

# ============================================================================
# Database Configuration
# ============================================================================
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/stitchflow

# SQLite (for development/testing):
DATABASE_URL=sqlite:///./stitchflow.db

# ============================================================================
# Z.AI GLM API Configuration (REQUIRED)
# ============================================================================
# Get your API key from: https://api.ilmu.ai or https://open.bigmodel.cn
ZHIPU_API_KEY=your_api_key_here

# Model selection:
# - ilmu-glm-5.1 (GLM-5.1 via ilmu.ai - recommended)
# - glm-4-plus (GLM-4.5)
# - glm-4-flash (faster, cheaper)
GLM_MODEL=ilmu-glm-5.1

# API endpoint:
# - https://api.ilmu.ai/anthropic (for Anthropic-compatible endpoint)
# - https://open.bigmodel.cn/api/paas/v4 (for ZhipuAI SDK endpoint)
GLM_BASE_URL=https://api.ilmu.ai/anthropic

# ============================================================================
# Security (CHANGE IN PRODUCTION!)
# ============================================================================
# Generate a secure secret key:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_secret_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# File Upload Configuration
# ============================================================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50  # Maximum file size in megabytes
ALLOWED_FILE_TYPES=pdf,docx,txt,eml  # Comma-separated list

# ============================================================================
# Retry Configuration
# ============================================================================
MAX_RETRIES=3  # Maximum number of retry attempts
RETRY_INITIAL_DELAY=1.0  # Initial delay in seconds
RETRY_BACKOFF_FACTOR=2.0  # Exponential backoff multiplier

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=./logs/stitchflow.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ============================================================================
# CORS Configuration (for frontend)
# ============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173  # Comma-separated list
CORS_ALLOW_CREDENTIALS=True

# ============================================================================
# Feature Flags (Optional)
# ============================================================================
ENABLE_TC_COMPARISON=True  # Enable T&C comparison feature
ENABLE_CONFLICT_RESOLUTION=True  # Enable conflict resolution

# ============================================================================
# Development/Testing
# ============================================================================
# Set to True to seed database with sample policy rules on startup
SEED_POLICY_RULES=True

# Set to True to enable API documentation at /docs
ENABLE_API_DOCS=True
